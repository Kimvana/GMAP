# ----- Choosing models and methods -----
map_directory                             /Users/lacour/Documents/GitHub/GMAP/GMAP/maps  
maps_to_use                               AmideBB AmideSC  
influencers_whitelist                     :All  

couplings_to_use                          ProteinAmide :All  
output_data                               ham  
estatics_method                           perres_nocut  
neutral_charge_threshold                  0.01  
guess_bonds                               False  

# charges up to a distance of (estatic_range - (estatic_smooth_range/2)) are
# treated fully. Then, for a distance of estatic_smooth_range, they 'count'
# less and less, until the distance of
# (estatic_range + (estatic_smooth_range/2)), where no charges are considered
# anymore.
estatic_range                             20.0  # this is in angstrom
estatic_smooth_range                      0.0  # this is in angstrom

# in order to allow start+number=stop, stop is exclusive.
start_frame                               0  
number_frames                             1  
stop_frame                                1  


# ----- Choosing what the program outputs look like -----
verbose                                   3  
verbose_logfile                           4  
safe_mode                                 False  
dark_mode                                 True  
command_line_color                        24bit  
command_line_length                       79  
prevent_overwrite                         False  
dont_report_error                         None  
output_format                             txt  
couplingvis_figsize                       8.5  # width of figure in inches
couplingvis_dpi                           300  



